{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streak Orb",
  "version": "0.1.0",
  "identifier": "com.streakorb.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Streak Orb",
        "url": "index.html",
        "width": 360,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Streaks",
        "url": "index.html",
        "width": 760,
        "height": 580,
        "minWidth": 680,
        "minHeight": 480,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "orb",
        "title": "Reminder",
        "url": "index.html",
        "width": 340,
        "height": 230,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
